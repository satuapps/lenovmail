# Lenovmail — authored by satuapps (satuapps.com)
# Values in this file are convenient for running tooling from the HOST (uv run alembic, uvicorn,
# pytest, CLI). docker-compose.yml overrides DATABASE_URL/REDIS_URL/BLOB_ROOT with internal
# service names (db, redis) and the container volume.
LENOVMAIL_DATABASE_URL=postgresql+asyncpg://lenovmail:lenovmail@localhost:5433/lenovmail
LENOVMAIL_REDIS_URL=redis://localhost:6380/0

# Required: base64 of 32 random bytes. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Changing this value makes every stored credential (IMAP/SMTP passwords, Microsoft
# tokens, Graph deltaLink) undecryptable — they will need to be re-entered.
LENOVMAIL_SECRET_KEY=

LENOVMAIL_BLOB_ROOT=./var/blobs
LENOVMAIL_PUBLIC_BASE_URL=http://localhost:8080
LENOVMAIL_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,localhost,127.0.0.1
LENOVMAIL_SESSION_TTL_DAYS=14

LENOVMAIL_MS_CLIENT_ID=
LENOVMAIL_MS_CLIENT_SECRET=
LENOVMAIL_MS_AUTHORITY=https://login.microsoftonline.com/common

LENOVMAIL_SYNC_INTERVAL_S=300
LENOVMAIL_GRAPH_POLL_INTERVAL_S=60
LENOVMAIL_IMAP_MAX_CONN_PER_ACCOUNT=3
LENOVMAIL_HEADER_FETCH_CHUNK=200
LENOVMAIL_BODY_FETCH_CHUNK=25
LENOVMAIL_BODY_FULL_FETCH_MAX_BYTES=26214400
LENOVMAIL_BODY_BACKFILL_MAX_PER_RUN=500
LENOVMAIL_FLAG_REFRESH_EVERY=6
LENOVMAIL_GRAPH_BODY_CONCURRENCY=6

# arq worker (sync, body backfill, IDLE, outbox delivery).
LENOVMAIL_WORKER_MAX_JOBS=10
LENOVMAIL_WORKER_JOB_TIMEOUT_S=900
# Length of one IMAP IDLE cycle before the connection is refreshed.
LENOVMAIL_IDLE_RENEW_S=1500
LENOVMAIL_SMTP_TIMEOUT_S=30

LENOVMAIL_AGENT_SEND_LIMIT_PER_HOUR=20
LENOVMAIL_LOG_LEVEL=INFO
